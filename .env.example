POSTGRES_DB=healthcare_factory
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://healthcare:change_me@localhost:5433/healthcare_factory
SYNTHETIC_SEED=20260810
SYNTHETIC_PATIENTS=2000
PSEUDONYMIZATION_SECRET=replace-with-a-local-development-secret
PSEUDONYMIZATION_KEY_ID=local-dev-v1
IMPORT_ALLOWED_POSTGRES_HOSTS=localhost,127.0.0.1,db
IMPORT_ALLOWED_POSTGRES_PORTS=5432
IMPORT_MAX_ROWS=1000
IMPORT_MAX_UPLOAD_BYTES=10000000
# Optional: leave blank to use local rules and retrieval only.
MAPPING_MODE=HYBRID
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=15
# Absolute in-container path to the supplied synthetic CSV bundle; leave blank outside benchmark runs.
FACTORY_BENCHMARK_BUNDLE_PATH=
